    "yet-another-react-lightbox": "^3.30.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@mtobdvlb/shared-types": "workspace:*",
    "@mtobdvlb/tailwind-config": "workspace:*",
    "@mtobdvlb/typescript-config": "workspace:*",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/dplayer": "^1.25.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "barrelsby": "^2.8.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
