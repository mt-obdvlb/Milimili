{
  "name": "milimili",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "pnpm run test:server && pnpm run test:web",
    "test:server": "pnpm --filter server exec vitest run --config src/__test__/vitest.config.ts",
    "test:web": "pnpm --filter web exec vitest run --config src/__test__/vitest.config.ts",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/supertest": "^7.2.0",
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.13.2",
    "@next/eslint-plugin-next": "^16.2.1",
    "@tanstack/eslint-plugin-query": "^5.95.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.8.21",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "jsdom": "^29.0.1",
    "supertest": "^7.2.2",
    "turbo": "^2.8.21",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
